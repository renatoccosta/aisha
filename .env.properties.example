# Local development secrets (do not commit .env.properties)
# Copy this file to .env.properties and adjust values.

# OAuth2 client (example: Google)
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret

# PostgreSQL profile local credentials
DB_URL=jdbc:postgresql://localhost:5432/aisha
DB_USERNAME=aisha
DB_PASSWORD=change-me

# Local seed user
AISHA_SECURITY_SEED_USERNAME=admin
AISHA_SECURITY_SEED_PASSWORD=change-this-password
